# Copy this file to .env and fill in real values before running the tests.
# The .env file is gitignored.
#
# Non-secret config (per-environment ApiBaseUrl, etc.) lives in appsettings.{env}.json.
# This file holds credentials + the environment selector only.

# Selects which appsettings.{environment}.json to load.
# Available out of the box: Staging, Dev. Add your own appsettings.<name>.json to extend.
ENVIRONMENT=Staging

TESTER_LOGIN=your_tester_login
TESTER_PASSWORD=your_tester_password
